# =========================================================================
# AUTO LOOT CLAIMER - CONFIGURATION ENVIRONMENT
# Copy this file to .env and fill in your values
# =========================================================================

# -------------------------------------------------------------------------
# TWITCH DROPS MINER & CLAIMER
# -------------------------------------------------------------------------
# How to get your auth-token without giving away your password:
# 1. Open https://www.twitch.tv in your desktop browser (logged in).
# 2. Press F12 -> Application tab -> Cookies -> https://www.twitch.tv.
# 3. Copy the value of the 'auth-token' cookie.
TWITCH_AUTH_TOKEN=

# Comma-separated list of games you want to prioritize (e.g., "Rust,Overwatch 2,World of Warcraft").
# Leave blank to automatically mine and claim ALL active drop campaigns.
TWITCH_PRIORITY_GAMES=

# -------------------------------------------------------------------------
# EPIC GAMES STORE AUTO-CLAIMER
# -------------------------------------------------------------------------
# Your Epic Games account credentials.
# Tip: If 2FA is enabled (recommended), provide the base32 TOTP secret key
# or log in once via the noVNC web interface on port 6080.
EG_EMAIL=
EG_PASSWORD=
EG_OTP_SECRET=

# -------------------------------------------------------------------------
# AMAZON PRIME GAMING AUTO-CLAIMER
# -------------------------------------------------------------------------
# Your Amazon account credentials.
PG_EMAIL=
PG_PASSWORD=
PG_OTP_SECRET=

# -------------------------------------------------------------------------
# GOG GIVEAWAYS AUTO-CLAIMER (Optional)
# -------------------------------------------------------------------------
GOG_EMAIL=
GOG_PASSWORD=

# -------------------------------------------------------------------------
# NOTIFICATIONS (Optional)
# -------------------------------------------------------------------------
# Discord or Telegram webhook URL to receive notifications whenever games
# or Twitch drops are successfully claimed.
DISCORD_WEBHOOK_URL=

# -------------------------------------------------------------------------
# DASHBOARD SIGN-IN CREDENTIALS (for web login page)
# -------------------------------------------------------------------------
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=admin123

